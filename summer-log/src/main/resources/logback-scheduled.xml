<?xml version="1.0" encoding="UTF-8"?>
<included>
    <appender name="scheduledAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/scheduled${NAME_SUFFIX}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HISTORY_HOME}/%d{yyyyMM, aux}/scheduled%d{yyyyMMdd}${NAME_SUFFIX}.log.gz
            </fileNamePattern>
            <maxHistory>${MAX_HISTORY}</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${BIZ_LOG}</pattern>
        </encoder>
        <filter>
            <value>SCHEDULED</value>
        </filter>
    </appender>

    <root level="INFO">
        <appender-ref ref="scheduledAppender"/>
    </root>
</included>
